{
	"name": "n8n-nodes-minopa",
	"version": "0.1.0",
	"description": "n8n node for Minopa: draft, schedule and publish social media posts to Instagram, TikTok, LinkedIn, X, YouTube, Pinterest, Threads and Facebook Pages, upload media and read analytics.",
	"license": "MIT",
	"homepage": "https://minopa.com/en/developers",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"minopa",
		"social media",
		"instagram",
		"tiktok",
		"linkedin",
		"youtube",
		"scheduling"
	],
	"author": {
		"name": "Minopa",
		"email": "info@minopa.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/minopacom/n8n-nodes-minopa.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/MinopaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Minopa/Minopa.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.19.0",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
